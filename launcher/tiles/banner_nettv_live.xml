<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen tile (config.xml, app_banners): tonal field, top-left light, bottom shade, icon with soft shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#FF4F7BFF" android:centerColor="#FF2347D9" android:endColor="#FF0D1B6B" />
        </shape>
    </item>
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="230dp" android:centerX="0.12" android:centerY="0.0" android:startColor="#38FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#47000000" android:centerColor="#00000000" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center" android:top="7dp" android:drawable="@drawable/ic_sym_live_tv_shadow" />
    <item android:width="96dp" android:height="96dp" android:gravity="center" android:drawable="@drawable/ic_sym_live_tv" />
    <item android:width="18dp" android:height="18dp" android:gravity="top|end" android:top="46dp" android:right="114dp">
        <shape android:shape="oval"><solid android:color="#FFFF453A" /><stroke android:width="3dp" android:color="#FF2347D9" /></shape>
    </item>
</layer-list>
